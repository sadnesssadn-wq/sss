<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- 子标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- 状态显示 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 未启动"
            android:textColor="#8E8E93"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- 当前选中的预设 -->
        <TextView
            android:id="@+id/tvSelectedPreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前：甜美女声"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 音效预设按钮组 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择音效"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- 甜美女声 -->
        <Button
            android:id="@+id/btnSweetFemale"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/sweet_female"
            android:textSize="18sp"
            android:backgroundTint="#FF69B4"
            android:layout_marginBottom="12dp" />

        <!-- 磁性男声 -->
        <Button
            android:id="@+id/btnMagneticMale"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/magnetic_male"
            android:textSize="18sp"
            android:backgroundTint="#4169E1"
            android:layout_marginBottom="12dp" />

        <!-- 可爱萝莉 -->
        <Button
            android:id="@+id/btnCuteLoli"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/cute_loli"
            android:textSize="18sp"
            android:backgroundTint="#FF1493"
            android:layout_marginBottom="12dp" />

        <!-- 原声模式 -->
        <Button
            android:id="@+id/btnOriginal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/original"
            android:textSize="18sp"
            android:backgroundTint="#808080"
            android:layout_marginBottom="24dp" />

        <!-- 测试模式按钮 -->
        <Button
            android:id="@+id/btnTestVoice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🎧 测试效果（戴耳机）"
            android:textSize="16sp"
            android:backgroundTint="#FF9500"
            android:layout_marginBottom="12dp" />

        <!-- 控制按钮 -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="▶ 开始变声"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#00C853"
            android:layout_marginBottom="24dp" />

        <!-- 游戏模式开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/game_mode"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGameMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 监听音量控制 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="耳机监听音量"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBarVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80"
            android:layout_marginBottom="24dp" />

        <!-- 使用说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usage_instructions"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
